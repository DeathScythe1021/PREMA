{
  "id": "wabi-sabi",
  "name_zh": "侘寂",
  "name_en": "Wabi Sabi",
  "summary": "接受不完美與時間痕跡的日式美學：粗糙材質、大地色、不對稱、大量留白，安靜而有溫度。",
  "definition": "侘寂（Wabi Sabi）欣賞不完美、不永恆、不完整的美：有裂痕的陶器、褪色的木頭、粗糙的和紙、一枝枯枝。轉成簡報時，版面不對稱、留白比內容多，色彩是土、灰、米、炭的大地色，文字少而沉靜，偶爾用一道毛筆筆觸或一塊不規則的形狀當重點。",
  "keywords": [
    "安靜",
    "自然",
    "不完美",
    "留白"
  ],
  "best_for": [
    "生活風格與工藝品牌",
    "茶、陶、手作、空間設計",
    "冥想與身心靈",
    "個人理念分享"
  ],
  "not_for": [
    "資訊密集的報告",
    "熱鬧的活動宣傳"
  ],
  "traits": [
    "大地色：土、灰、米、炭",
    "粗糙紙張與陶土質感",
    "不對稱構圖",
    "大量留白",
    "不規則有機形狀",
    "毛筆或墨跡筆觸"
  ],
  "layout": [
    "不對稱：主體偏一側，另一側大片留白",
    "文字少，標題可以直排",
    "用一塊不規則形狀或一道墨跡當視覺重心",
    "照片小而安靜，不滿版"
  ],
  "motifs": [
    "不規則圓（像手捏陶器）",
    "墨跡筆觸",
    "和紙纖維",
    "直排文字",
    "小印章"
  ],
  "typography": {
