    "rules": [
      "字重偏細，不要粗體",
      "中文標題可以 writing-mode: vertical-rl 直排",
      "行距寬鬆"
    ]
  },
  "imagery": [
    "陶器、木頭、石頭、枯枝、和紙",
    "照片低飽和、自然光、陰影柔和",
    "可以留下不完美的邊緣"
  ],
  "placeholder": "一塊不規則圓角的米灰形狀，右下小字直排寫「器物照片」，旁邊一個朱色小印",
  "avoid": [
    "高飽和色",
    "完美對稱與整齊格線",
