      "weights": "500、900",
      "role": "中文大標用 900"
    },
    "google_fonts": "https://fonts.googleapis.com/css2?family=Anton&family=Courier+Prime:wght@400;700&family=Noto+Sans+TC:wght@500;900&display=swap",
    "rules": [
      "大標行距要緊，0.9 左右",
      "筆記與標籤一律用打字機字",
      "不要用細字重"
    ]
  },
  "imagery": [
    "夜間森林、霧、紅外線相機質感",
    "模糊、晃動、顆粒重的照片反而加分",
    "線稿生物或腳印插畫"
  ],
  "placeholder": "暗色方框，四周有拍立得白邊，中間寫「EVIDENCE 03｜目擊照片 4:3」，角落一個紅筆圈",
  "avoid": [
    "明亮粉彩",
    "乾淨的扁平圖示",
