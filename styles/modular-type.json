    "rules": [
      "封面大字最好用 CSS 幾何零件拼出",
      "內文用幾何無襯線，字重兩種就好",
      "所有文字對齊網格"
    ]
  },
  "imagery": [
    "照片裁成圓形、半圓或方塊，當成零件之一",
