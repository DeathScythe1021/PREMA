    "里程碑與宣言"
  ],
  "not_for": [
    "學術報告",
    "需要中性專業感的商務提案"
  ],
  "traits": [
    "粗黑均勻輪廓線",
    "平塗限定色",
    "緞帶標語",
    "船錨、燕子、羅盤、玫瑰",
    "老紙張底色",
    "星星與光芒線"
  ],
  "layout": [
    "標題寫在一條飄動的緞帶上",
    "重點放在盾形或圓形徽章裡",
    "頁面像刺青圖稿紙：多個小圖案排在一頁，各配一行說明",
    "所有色塊都有粗黑邊"
  ],
  "motifs": [
