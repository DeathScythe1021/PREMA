    "google_fonts": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=EB+Garamond:ital,wght@0,400;1,400&family=Noto+Serif+TC:wght@400;700&display=swap",
    "rules": [
      "全部使用襯線字",
      "引言用斜體",
      "小標用大寫加字距"
    ]
  },
  "imagery": [
    "圖書館、書架、燭光、石造建築",
    "照片偏暗、暖色、加顆粒",
    "古典畫作與版畫"
  ],
  "placeholder": "雙線細框，四角有小花飾，中間斜體寫「Plate III — 插圖 4:5」",
  "avoid": [
    "明亮飽和色",
    "無襯線粗體",
