{
  "id": "light-academia",
  "name_zh": "明亮學院",
  "name_en": "Light Academia",
  "summary": "陽光、亞麻、詩集與古典雕像：米白、淺褐的明亮學院美學，溫柔、優雅、有書卷氣。",
  "definition": "Light Academia 是 Dark Academia 的白天版：灑進窗戶的陽光、亞麻桌布上的詩集、大理石雕像、乾燥花和手寫信。色調是米白、奶茶、淺褐，字體是優雅的襯線字與手寫字。轉成簡報時，畫面明亮、留白多，像一本精緻的詩集或展覽手冊。",
  "keywords": [
    "優雅",
    "溫柔",
    "書卷氣",
    "明亮"
  ],
  "best_for": [
    "教育與課程介紹",
    "文化與藝術活動",
    "個人介紹與作品集",
    "婚禮、典禮流程"
  ],
  "not_for": [
    "科技規格說明",
    "需要強烈視覺衝擊的發表"
  ],
  "traits": [
    "米白與淺褐色調",
    "優雅襯線字",
    "大理石雕像與乾燥花",
    "陽光與窗影",
    "手寫字點綴",
    "細線與大量留白"
  ],
  "layout": [
    "大量留白，內容集中在窄欄",
    "標題用優雅襯線大字，旁邊一行小手寫字",
    "照片用拱形或細框，像畫冊",
    "頁碼與章節用小號大寫襯線字"
  ],
  "motifs": [
    "拱形框",
    "細線與小星號",
    "乾燥花枝",
    "手寫註記",
    "羅馬數字"
  ],
