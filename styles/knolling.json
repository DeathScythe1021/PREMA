    "google_fonts": "https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;700&display=swap",
    "rules": [
      "英文標籤一律大寫並加字距",
      "字級最多四級",
      "不要斜體"
    ]
  },
  "imagery": [
    "正上方俯拍的物件，背景是純色桌面或紙張",
    "去背物件排成方陣",
    "硬光、陰影短，或乾脆沒有陰影",
    "照片不要歪斜、不要透視角度"
  ],
  "placeholder": "虛線方框，四角有十字對位記號，中間用等寬字寫「OBJECT 03／俯拍，1:1」",
  "avoid": [
    "斜放或旋轉的元素",
    "透視與 3D 角度",
    "元素重疊",
    "漸層背景",
    "大圓角卡片與厚陰影"
  ],
  "color_rules": {
