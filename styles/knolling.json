{
  "id": "knolling",
  "name_zh": "擺拍陳列",
  "name_en": "Knolling",
  "summary": "物件以直角、等距、平行排列在純色平面上，從正上方俯拍的整理美學。",
  "definition": "Knolling 來自工作室把工具排整齊的習慣：所有物件轉成 90 度、彼此平行、間距相等，放在單一顏色的平面上俯拍。轉成簡報時，每一段內容都被當成一件「物件」，整齊排進網格，附上編號標籤，畫面安靜、精準、可以一眼數清楚。",
  "keywords": [
    "整齊",
    "精準",
    "冷靜",
    "產品感"
  ],
  "best_for": [
    "產品介紹",
    "工具與技能清單",
    "流程拆解",
    "作品細節"
  ],
  "not_for": [
    "情緒渲染的品牌故事",
    "需要大量文字論述的報告"
  ],
  "traits": [
    "正上方俯視角",
    "所有元素 90 度對齊",
    "元素之間間距完全相等",
    "單一純色背景",
    "物件彼此不重疊",
    "小型編號與名稱標籤"
  ],
  "layout": [
    "以等寬網格排列內容，格與格的間距一致",
    "每個內容區塊都有編號（01、02…）和小標籤，像物件的名牌",
    "標題小而精準，固定放在左上角，不置中",
    "大量均等留白，留白本身就是結構",
    "清單類內容排成方陣，不用條列"
  ],
  "motifs": [
    "角落十字對位記號",
    "1px 細線尺規與刻度",
    "等寬字標籤",
    "物件下方極短的平行投影（可省略）"
  ],
  "typography": {
    "display": {
      "family": "Archivo",
